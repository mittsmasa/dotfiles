      "mcp__Figma_Dev_Mode_MCP__get_screenshot",
      "mcp__Figma_Dev_Mode_MCP__get_variable_defs",
      "mcp__Figma_Dev_Mode_MCP__get_metadata",
      "mcp__Figma_Dev_Mode_MCP__get_code_connect_map",
      "mcp__figma-dev-mode-mcp-server__get_design_context",
      "mcp__figma-dev-mode-mcp-server__get_screenshot",
      "mcp__next-devtools__upgrade_nextjs_16",
      "SlashCommand(/create-component:*)",
      "SlashCommand(/generate-stories:*)"
    ],
    "deny": [
      "Bash(killall:*)",
      "Bash(npx:*)",
      "Bash(pkill:*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(~/Library/Keychains/**)",
      "Read(~/Library/Cookies/**)",
      "Bash(gh auth token *)",
      "Bash(gh auth status *--show-token*)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(fnox get *)",
      "Bash(fnox export *)",
      "Bash(fnox ex *)",
      "Bash(fnox env *)"
    ],
    "defaultMode": "auto"
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "excludedCommands": ["gh *", "git fetch *", "git pull *", "git push *", "git ls-remote *", "mise install", "mise install *", "fnox exec -- pnpm install", "fnox exec -- pnpm install *", "git commit *", "pnpm exec vitest *", "pnpm vrt", "pnpm vrt *"],
    "filesystem": {
      "allowWrite": ["~/.local/state/mise", "~/.local/share/chezmoi", "~/.config/chezmoi", "~/.npm"],
      "denyRead": ["~/.zsh_history", "~/.zsh_sessions"]
    },
    "network": {
      "allowedDomains": ["github.com", "api.github.com", "registry.npmjs.org", "npm.pkg.github.com"],
      "strictAllowlist": true,
      "allowLocalBinding": true
    },
    "credentials": {
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NODE_AUTH_TOKEN", "mode": "deny" }
      ],
      "files": [
        { "path": "~/.ssh", "mode": "deny" }
      ]
    }
  },
  "model": "claude-sonnet",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/concise-response-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/response-length-logger.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/detect-multiplexer.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/concise-jp-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/concise-jp-reminder.sh",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/npx-redirect-hook.sh",
            "if": "Bash(npx *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/plan-review-hook.sh",
            "timeout": 1800
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/chezmoi-sync-hook.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/fnox-auth-hint.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/notify.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "document-skills@anthropic-agent-skills": false,
    "context7@claude-plugins-official": true,
    "cowork-plugin-management@inline": false
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "maaya",
  "language": "日本語",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "voice": {
    "enabled": false,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": false
}
